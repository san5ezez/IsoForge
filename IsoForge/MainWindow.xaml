<Window x:Class="IsoForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IsoForge" Height="850" Width="1450" MinHeight="650" MinWidth="1050" Background="#101827" Foreground="White" AllowDrop="True" Drop="Window_Drop">
<Grid Margin="8">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Menu Grid.Row="0" Background="#172033" Foreground="White">
<MenuItem Header="_Файл"><MenuItem Header="Создать" Click="New_Click"/><MenuItem Header="Открыть ISO..." Click="Open_Click"/><MenuItem Header="Сохранить как..." Click="SaveAs_Click"/><Separator/><MenuItem Header="Свойства образа..." Click="Properties_Click"/><Separator/><MenuItem Header="Выход" Click="Exit_Click"/></MenuItem>
<MenuItem Header="_Действие"><MenuItem Header="Добавить файлы..." Click="Add_Click"/><MenuItem Header="Создать папку в образе" Click="NewFolder_Click"/><MenuItem Header="Извлечь выбранное..." Click="Extract_Click"/><MenuItem Header="Переименовать выбранное..." Click="Rename_Click"/><MenuItem Header="Удалить выбранное" Click="Delete_Click"/></MenuItem>
<MenuItem Header="_Самозагрузка"><MenuItem Header="Выбрать загрузочный файл..." Click="BootFile_Click"/><MenuItem Header="Сбросить загрузочный файл" Click="ClearBoot_Click"/></MenuItem>
<MenuItem Header="_Инструменты"><MenuItem Header="Записать ISO на USB..." Click="WriteUsb_Click"/><MenuItem Header="Смонтировать ISO" Click="Mount_Click"/><MenuItem Header="Извлечь ISO из диска (через Проводник)" Click="DiscInfo_Click"/><MenuItem Header="Проверить SHA-256..." Click="Hash_Click"/></MenuItem>
<MenuItem Header="_Опции"><MenuItem Header="О программе" Click="About_Click"/></MenuItem>
</Menu>
<WrapPanel Grid.Row="1" Background="#172033" Margin="0,5,0,7">
<Button Content="📄 Создать" Click="New_Click"/><Button Content="📂 Открыть" Click="Open_Click"/><Button Content="💾 Сохранить как" Click="SaveAs_Click"/><Separator/><Button Content="➕ Добавить" Click="Add_Click"/><Button Content="📤 Извлечь" Click="Extract_Click"/><Separator/><Button Content="💿 Смонтировать" Click="Mount_Click"/><Button Content="🔥 Записать USB" Click="WriteUsb_Click"/><Button Content="🔐 SHA-256" Click="Hash_Click"/>
</WrapPanel>
<Grid Grid.Row="2">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Row="0" Grid.Column="0" Background="#172033" CornerRadius="5" Padding="7"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ОБРАЗ — дерево каталогов" FontWeight="Bold" Margin="4"/><TreeView x:Name="IsoTree" Background="#172033" Foreground="White" SelectedItemChanged="IsoTree_SelectedItemChanged"/></DockPanel></Border>
<GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="7" Background="#33435E" HorizontalAlignment="Stretch"/>
<Border Grid.Row="0" Grid.Column="2" Background="#172033" CornerRadius="5" Padding="7"><DockPanel><TextBlock DockPanel.Dock="Top" Text="СОДЕРЖИМОЕ ISO  •  Перетаскивайте сюда файлы с компьютера" FontWeight="Bold" Margin="4"/><ListView x:Name="IsoList" Background="#172033" Foreground="White" AllowDrop="True" Drop="IsoList_Drop" MouseDoubleClick="IsoList_DoubleClick"><ListView.View><GridView><GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="390"/><GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Kind}" Width="100"/><GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeText}" Width="120"/></GridView></ListView.View></ListView></DockPanel></Border>
<GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="7" Background="#33435E" HorizontalAlignment="Stretch"/>
<Border Grid.Row="2" Grid.Column="0" Background="#172033" CornerRadius="5" Padding="7"><DockPanel><TextBlock DockPanel.Dock="Top" Text="КОМПЬЮТЕР — диски и папки" FontWeight="Bold" Margin="4"/><TreeView x:Name="PcTree" Background="#172033" Foreground="White" SelectedItemChanged="PcTree_SelectedItemChanged"/></DockPanel></Border>
<Border Grid.Row="2" Grid.Column="2" Background="#172033" CornerRadius="5" Padding="7"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ЛОКАЛЬНЫЕ ФАЙЛЫ  •  Перетаскивайте в окно ISO" FontWeight="Bold" Margin="4"/><ListView x:Name="PcList" Background="#172033" Foreground="White" AllowDrop="True" MouseDoubleClick="PcList_DoubleClick"><ListView.View><GridView><GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="390"/><GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Kind}" Width="100"/><GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeText}" Width="120"/></GridView></ListView.View></ListView></DockPanel></Border>
</Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4"><TextBlock Text="Файловая система:" VerticalAlignment="Center"/><ComboBox x:Name="FsCombo" Width="150" Margin="7,2" SelectedIndex="1"><ComboBoxItem Content="ISO 9660"/><ComboBoxItem Content="Joliet"/></ComboBox><TextBlock Text="Метка тома:" VerticalAlignment="Center"/><TextBox x:Name="VolumeBox" Text="ISOFORGE" Width="150" Margin="7,2" Padding="5"/><TextBlock Text="Носитель:" VerticalAlignment="Center"/><ComboBox x:Name="MediaCombo" Width="130" Margin="7,2" SelectedIndex="1" SelectionChanged="MediaCombo_SelectionChanged"><ComboBoxItem Content="CD 700 MB"/><ComboBoxItem Content="DVD 4.7 GB"/><ComboBoxItem Content="DVD 8.5 GB"/></ComboBox><ProgressBar x:Name="SizeBar" Width="260" Height="18" Margin="8,4" Maximum="100"/><TextBlock x:Name="SizeText" VerticalAlignment="Center"/></StackPanel>
<StatusBar Grid.Row="4" Background="#172033" Foreground="White"><StatusBarItem><TextBlock x:Name="StatusText" Text="Готово. Создайте новый образ или откройте ISO."/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="PathText" Text="ISO: /"/></StatusBarItem></StatusBar>
</Grid></Window>